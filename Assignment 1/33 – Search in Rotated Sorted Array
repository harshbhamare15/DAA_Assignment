class Solution {
    public int search(int[] nums, int target) {
        int n = nums.length;
        int left = 0;
        int right = n-1;

        while (left < right) {
            int mid = left +  (right-left) / 2;
            if (nums[mid] > nums[right]) {
                left = mid+1;
            } else {
                right = mid;
            }
        }
        int pivot = left;

        int low = 0;
        int high = n - 1;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            int rMid = (mid + pivot) % n;

            if (nums[rMid] == target) {
                return rMid;
            } else if (nums[rMid] < target) {
                low = mid+1;
            } else {
                high = mid-1;
            }
        }

        return -1;
    }
}
